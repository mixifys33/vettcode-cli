# VettCode CLI Configuration
# All API calls are proxied through the VettCode backend
# No API keys are needed in the CLI - everything is handled securely on the backend

# ==============================================================================
# BACKEND API CONFIGURATION (DEFAULT - ALWAYS WORKS)
# ==============================================================================

# Backend API URL (default: https://vettcodecli.vercel.app/api)
# This is the DEFAULT and RECOMMENDED way to use VettCode
# Only change this if you're self-hosting the backend
# VETTCODE_API_URL=https://vettcodecli.vercel.app/api

# Optional: Set environment for debugging (development/production)
# NODE_ENV=production

# ==============================================================================
# AI PROVIDER CONFIGURATION (OPTIONAL)
# ==============================================================================

# Preferred AI provider for code analysis:
# - 'backend': VettCode cloud API (DEFAULT - always works, no setup needed)
# - 'ollama': Local Ollama (privacy-first, offline, requires installation)
# - 'none': Static analysis only (no AI)
#
# DEFAULT: backend (existing behavior, no changes needed)
# AI_PROVIDER=backend

# Enable fallback between providers if one fails
# Set to 'false' to enforce a single provider
# AI_PROVIDER_FALLBACK=true

# ==============================================================================
# OLLAMA LOCAL AI (OPTIONAL - FOR ADVANCED USERS)
# ==============================================================================

# To use Ollama for local, offline AI analysis:
# 1. Set AI_PROVIDER=ollama above
# 2. Install Ollama (see instructions below)
# 3. Run: vettcode --setup-ollama
# 4. Start scanning with local AI

# Ollama configuration (only needed if AI_PROVIDER=ollama)
# Default: http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# Ollama model to use (default: qwen2.5-coder:1.5b-instruct)
# This is a lightweight 1.5B parameter model optimized for code
# Download size: ~1-2GB
# OLLAMA_MODEL=qwen2.5-coder:1.5b-instruct

# ==============================================================================
# OLLAMA INSTALLATION (ONLY IF YOU WANT LOCAL AI)
# ==============================================================================
#
# Ollama is OPTIONAL and provides these benefits:
# - ✅ 100% offline - no internet required
# - ✅ 100% private - code never leaves your machine
# - ✅ 100% free - no API costs
# - ✅ Fast - sub-second analysis per batch
# - ✅ Unlimited - no rate limits
#
# Installation:
# 1. Install Ollama:
#    - macOS: brew install ollama  OR  download from https://ollama.com
#    - Windows: download from https://ollama.com
#    - Linux: curl -fsSL https://ollama.com/install.sh | sh
#
# 2. Start Ollama:
#    - ollama serve
#
# 3. Download model:
#    - vettcode --setup-ollama
#    OR manually: ollama pull qwen2.5-coder:1.5b-instruct
#
# 4. Configure VettCode to use Ollama:
#    - Set AI_PROVIDER=ollama above
#
# 5. Start scanning:
#    - vettcode scan
#
# NOTE: If you don't install Ollama, VettCode will continue using the
# cloud backend API (existing behavior) - nothing changes!
#
# ==============================================================================

# NOTE: If you want to use your own API keys instead of the VettCode backend,
# you would need to fork the project and modify the source code.
# See: https://github.com/mixifys33/vettcode-cli for more information
