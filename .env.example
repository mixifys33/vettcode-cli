# VettCode CLI Configuration
# All API calls are proxied through the VettCode backend
# No API keys are needed in the CLI - everything is handled securely on the backend

# Backend API URL (default: https://vettcodecli.vercel.app/api)
# Only change this if you're self-hosting the backend
# VETTCODE_API_URL=https://vettcodecli.vercel.app/api

# Optional: Set environment for debugging (development/production)
# NODE_ENV=production

# NOTE: If you want to use your own API keys instead of the VettCode backend,
# you would need to fork the project and modify the source code.
# See: https://github.com/mixifys33/vettcode-cli for more information
